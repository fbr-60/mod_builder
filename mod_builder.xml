<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
	<name>mod_builder</name>
	<author>Joomla! Project</author>
	<creationDate>2004-07</creationDate>
	<copyright>(C) 2005 Open Source Matters, Inc.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>admin@joomla.org</authorEmail>
	<authorUrl>www.joomla.org</authorUrl>
	<version>1.0.0</version>
	<description>MOD_BUILDER_XML_DESCRIPTION</description>
	<namespace path="src">Joomla\Module\Builder</namespace>
	<customContent />
	<files>
		<folder module="mod_builder">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/mod_builder.ini</language>
		<language tag="en-GB">language/en-GB/mod_builder.sys.ini</language>
	</languages>
	<help key="Site_Modules:_Builder" />
	<config>
		<fields name="params">
			<fieldset name="options" label="COM_MODULES_BASIC_FIELDSET_LABEL">
				<field
					name="prepare_content"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					label="MOD_BUILDER_FIELD_PREPARE_CONTENT_LABEL"
					description="MOD_BUILDER_FIELD_PREPARE_CONTENT_DESC"
					default="0"
					filter="integer"
					>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>

				<field
					name="backgroundimage"
					type="media"
					schemes="http,https,ftp,ftps,data,file"
					validate="url"
					relative="true"
					label="MOD_BUILDER_FIELD_BACKGROUNDIMAGE_LABEL"
				/>
				<field
					name="backgroundcolor" 
					type="color" 
					default="#e5e5e5" 
					format="hex"
					label="Select background color"
					description="If not use background-image"
				/>
				
				<field
					name="bg_type"
					type="list"
					label="Background image vs color"
					description=""
					default="2"
					filter="integer"
				>
					<option value="2">NONE</option>
					<option value="0">Color</option>
					<option value="1">Image</option>
				</field>

				<field
					name="bg_animate"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					label="Animate background"
					description=""
					default="0"
					filter="integer"
					>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>

			</fieldset>
			
			<fieldset name="settings" label="Settings">
				
				<field
					name="adv_media"
					type="media"
					schemes="http,https,ftp,ftps,data,file"
					validate="url"
					relative="true"
					label="Advaced Media"
				/>
				<field
					name="adv_box"
					type="textarea"
					label="Advanced block"
					filter="raw"
					rows="3"
				/>
				<field
					name="media_width"
					type="list"
					label="Media width"
					default=" uk-width-auto">
					<option value=" uk-width-medium">300px</option>
					<option value=" uk-width-large">450px</option>
					<option value=" uk-width-xlarge">600px</option>
					<option value=" uk-width-3-5">60%</option>
					<option value=" uk-width-1-2">50%</option>
					<option value=" uk-width-2-5">40%</option>
					<option value=" uk-width-1-3">33%</option>
					<option value=" uk-width-1-4">25%</option>
					<option value=" uk-width-auto">auto</option>
				</field>
				<field
					name="media_breakpoint"
					type="list"
					label="Media breakpoint"
					default="" >
					<option value="">none</option>
					<option value="@l ">1200px</option>
					<option value="@m ">960px</option>
					<option value="@s ">640px</option>
				</field>
				<field
					name="media_position"
					type="list"
					label="Media position"
					default="" >
					<option value="uk-flex-first ">left</option>
					<option value="uk-flex-last ">right</option>
				</field>
				<field
					name="wrap_container"
					type="list"
					label="To wrap container"
					default="" >
					<option value="">none</option>
					<option value="uk-container">container</option>
					<option value="uk-container-large uk-margin-auto">small container</option>
				</field>
				<field
					name="block_style"
					type="list"
					label="Style"
					default="" >
					<option value="uk-card uk-card-default uk-card-wrap uk-card-body uk-card-small uk-card-hover">card</option>
					<option value=" fbr-b ">border</option>
					<option value=" fbr ">padding</option>
					<option value="uk-panel">none</option>
				</field>
				
				
			</fieldset>
			
			<fieldset name="advanced">
				<field
					name="layout"
					type="modulelayout"
					label="JFIELD_ALT_LAYOUT_LABEL"
					class="form-select"
					validate="moduleLayout"
				/>

				<field
					name="moduleclass_sfx"
					type="textarea"
					label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
					rows="3"
					validate="CssIdentifier"
				/>

				<field
					name="cache"
					type="list"
					label="COM_MODULES_FIELD_CACHING_LABEL"
					default="1"
					filter="integer"
					validate="options"
					>
					<option value="1">JGLOBAL_USE_GLOBAL</option>
					<option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
				</field>

				<field
					name="cache_time"
					type="number"
					label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
					default="900"
					filter="integer"
				/>

				<field
					name="cachemode"
					type="hidden"
					default="static"
					>
					<option value="static"></option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
